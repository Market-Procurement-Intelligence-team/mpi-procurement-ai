# MPI Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or share it publicly!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server only. Used by netlify/functions/request-reader.ts (and the dev server).
# Never give it a VITE_ prefix: anything starting with VITE_ is copied into the
# browser code that every visitor downloads.
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
